[Unit]
Description=DaolVision production web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/admin/DaolVision/localai-ui
Environment=NODE_ENV=production
Environment=UI_HOST=0.0.0.0
Environment=UI_PORT=5199
Environment=LOCALAI_URL=http://127.0.0.1:8080
ExecStart=/usr/bin/node /home/admin/DaolVision/localai-ui/serve.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
